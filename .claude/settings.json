{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(pnpm --dir src/UI/mango-ui lint:*)",
      "Bash(pnpm --dir src/UI/mango-ui build:*)",
      "Bash(pnpm install --dir src/UI/mango-ui:*)",
      "Bash(pwsh ./scripts/sync-agent-harness.ps1:*)",
      "Bash(docker compose -f docker-compose.mcp.yaml:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": []
  },
  "enabledMcpjsonServers": [
    "serena"
  ],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
