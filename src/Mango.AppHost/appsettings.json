{
  "IdentityType": "OpenIddict", // "OpenIddict", "Duende"
  "UseGrafanaStack": true, // true = also run Grafana + Prometheus + Loki; false = Aspire dashboard only
  "Parameters": {
    "postgres-password": "postgres",
    "rabbitmq-password": "YourSecretPassword"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
